{
  "name": "cursor-subscription-for-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.3.2",
  "publisher": "ark4ez",
  "license": "MIT",
  "type": "module",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bovmelo/cursor-agent-vscode-extension.git"
  },
  "bugs": {
    "url": "https://github.com/Bovmelo/cursor-agent-vscode-extension/issues"
  },
  "homepage": "https://github.com/Bovmelo/cursor-agent-vscode-extension#readme",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI"
  ],
  "keywords": [
    "cursor",
    "agent",
    "ai",
    "chat",
    "sdk"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Chat remains available. Hooks, verification commands, autonomous Supervisor, auto-apply, auto-repair, and background agents stay disabled until the workspace is trusted.",
      "restrictedConfigurations": [
        "cursorSubscription.preEditCommands",
        "cursorSubscription.postEditCommands",
        "cursorSubscription.verificationCommands",
        "cursorSubscription.autoVerify",
        "cursorSubscription.autoRepair",
        "cursorSubscription.supervisorMode",
        "cursorSubscription.supervisorAutoApplySafeChanges"
      ]
    }
  },
  "activationEvents": [
    "onView:cursorSubscription.chatView",
    "onView:cursorSubscription.workspaceTree",
    "onCommand:cursorSubscription.generateCommitMessage",
    "onCommand:cursorSubscription.generateCode",
    "onCommand:cursorSubscription.explainSelection",
    "onCommand:cursorSubscription.addFileToChat",
    "onCommand:cursorSubscription.runAutopilot",
    "onCommand:cursorSubscription.reviewChanges",
    "onCommand:cursorSubscription.debugContext",
    "onCommand:cursorSubscription.reviewChangeSession",
    "onCommand:cursorSubscription.openFailureTimeMachine",
    "onCommand:cursorSubscription.reverifyChangeSession",
    "onCommand:cursorSubscription.executeLastPlan",
    "onCommand:cursorSubscription.scanSupervisorGitHub"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "npm run lint:typescript && npm run lint:scripts",
    "lint:typescript": "oxlint --type-aware --max-warnings=0 src",
    "lint:scripts": "eslint eslint.config.js prettier.config.js scripts/**/*.mjs",
    "format:check": "prettier --check .oxlintrc.json eslint.config.js prettier.config.js scripts/audit-dependencies.mjs scripts/run-coverage.mjs scripts/validate-webview-a11y.mjs scripts/vscode-a11y-loader.mjs scripts/vscode-a11y-mock.mjs test/dependencyPolicy.test.mjs",
    "validate:webview": "node scripts/validate-webview.mjs",
    "validate:a11y": "node scripts/validate-webview-a11y.mjs",
    "test": "npm run compile && node --test test/*.test.mjs",
    "test:coverage": "npm run compile && node scripts/run-coverage.mjs",
    "test:e2e": "npm run compile && node scripts/run-extension-tests.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "validate": "npm run lint && npm run format:check && npm run compile && npm run validate:webview && npm run validate:a11y && node scripts/run-coverage.mjs && npm run audit:dependencies",
    "vscode:prepublish": "npm run validate",
    "package": "vsce package",
    "package:target": "vsce package --target",
    "publish": "vsce publish"
  },
  "contributes": {
    "commands": [
      {
        "command": "cursorSubscription.openChat",
        "title": "%command.openChat%"
      },
      {
        "command": "cursorSubscription.openSettings",
        "title": "%command.openSettings%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "cursorSubscription.chooseWorkflow",
        "title": "%command.chooseWorkflow%",
        "icon": "$(compass)"
      },
      {
        "command": "cursorSubscription.chooseExecutionProfile",
        "title": "%command.chooseExecutionProfile%",
        "icon": "$(shield)"
      },
      {
        "command": "cursorSubscription.openOutput",
        "title": "%command.openOutput%",
        "icon": "$(output)"
      },
      {
        "command": "cursorSubscription.exportDiagnostics",
        "title": "%command.exportDiagnostics%"
      },
      {
        "command": "cursorSubscription.retryLastRun",
        "title": "%command.retryLastRun%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "cursorSubscription.openRunCenter",
        "title": "%command.openRunCenter%",
        "icon": "$(pulse)"
      },
      {
        "command": "cursorSubscription.setApiKey",
        "title": "%command.setApiKey%"
      },
      {
        "command": "cursorSubscription.clearApiKey",
        "title": "%command.clearApiKey%"
      },
      {
        "command": "cursorSubscription.showSetupChecklist",
        "title": "%command.showSetupChecklist%"
      },
      {
        "command": "cursorSubscription.newChat",
        "title": "%command.newChat%"
      },
      {
        "command": "cursorSubscription.findInChat",
        "title": "%command.findInChat%"
      },
      {
        "command": "cursorSubscription.generateCommitMessage",
        "title": "%command.generateCommitMessage%",
        "icon": "$(sparkle)"
      },
      {
        "command": "cursorSubscription.createPullRequest",
        "title": "%command.createPullRequest%"
      },
      {
        "command": "cursorSubscription.generateCode",
        "title": "%command.generateCode%"
      },
      {
        "command": "cursorSubscription.explainSelection",
        "title": "%command.explainSelection%"
      },
      {
        "command": "cursorSubscription.addFileToChat",
        "title": "%command.addFileToChat%"
      },
      {
        "command": "cursorSubscription.runAutopilot",
        "title": "%command.runAutopilot%"
      },
      {
        "command": "cursorSubscription.reviewChanges",
        "title": "%command.reviewChanges%"
      },
      {
        "command": "cursorSubscription.clearReview",
        "title": "%command.clearReview%"
      },
      {
        "command": "cursorSubscription.debugContext",
        "title": "%command.debugContext%"
      },
      {
        "command": "cursorSubscription.refreshProjectMemory",
        "title": "%command.refreshProjectMemory%"
      },
      {
        "command": "cursorSubscription.verifyChanges",
        "title": "%command.verifyChanges%"
      },
      {
        "command": "cursorSubscription.revertLastSession",
        "title": "%command.revertLastSession%"
      },
      {
        "command": "cursorSubscription.keepSessionEdit",
        "title": "%command.keepSessionEdit%",
        "icon": "$(check)"
      },
      {
        "command": "cursorSubscription.restoreSessionEdit",
        "title": "%command.restoreSessionEdit%",
        "icon": "$(discard)"
      },
      {
        "command": "cursorSubscription.keepAllSessionEdits",
        "title": "%command.keepAllSessionEdits%"
      },
      {
        "command": "cursorSubscription.restoreAllSessionEdits",
        "title": "%command.restoreAllSessionEdits%"
      },
      {
        "command": "cursorSubscription.chooseSupervisorMode",
        "title": "%command.chooseSupervisorMode%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "cursorSubscription.createSupervisorTask",
        "title": "%command.createSupervisorTask%",
        "icon": "$(add)"
      },
      {
        "command": "cursorSubscription.scanSupervisorDiagnostics",
        "title": "%command.scanSupervisorDiagnostics%",
        "icon": "$(search)"
      },
      {
        "command": "cursorSubscription.runSupervisorTask",
        "title": "%command.runSupervisorTask%",
        "icon": "$(play)"
      },
      {
        "command": "cursorSubscription.openSupervisorChange",
        "title": "%command.openSupervisorChange%"
      },
      {
        "command": "cursorSubscription.applySupervisorChange",
        "title": "%command.applySupervisorChange%",
        "icon": "$(check)"
      },
      {
        "command": "cursorSubscription.discardSupervisorChange",
        "title": "%command.discardSupervisorChange%",
        "icon": "$(discard)"
      },
      {
        "command": "cursorSubscription.applyAllSupervisorChanges",
        "title": "%command.applyAllSupervisorChanges%",
        "icon": "$(check-all)"
      },
      {
        "command": "cursorSubscription.discardAllSupervisorChanges",
        "title": "%command.discardAllSupervisorChanges%"
      },
      {
        "command": "cursorSubscription.dismissSupervisorTask",
        "title": "%command.dismissSupervisorTask%",
        "icon": "$(close)"
      },
      {
        "command": "cursorSubscription.runTaskPipeline",
        "title": "%command.runTaskPipeline%"
      },
      {
        "command": "cursorSubscription.exportAuditLog",
        "title": "%command.exportAuditLog%"
      },
      {
        "command": "cursorSubscription.refreshIntegrations",
        "title": "%command.refreshIntegrations%",
        "icon": "$(refresh)"
      },
      {
        "command": "cursorSubscription.previewIntegration",
        "title": "%command.previewIntegration%"
      },
      {
        "command": "cursorSubscription.enableIntegration",
        "title": "%command.enableIntegration%"
      },
      {
        "command": "cursorSubscription.disableIntegration",
        "title": "%command.disableIntegration%"
      },
      {
        "command": "cursorSubscription.openIntegration",
        "title": "%command.openIntegration%"
      },
      {
        "command": "cursorSubscription.scanSupervisorTodos",
        "title": "%command.scanSupervisorTodos%"
      },
      {
        "command": "cursorSubscription.scanSupervisorGitHub",
        "title": "%command.scanSupervisorGitHub%"
      },
      {
        "command": "cursorSubscription.compareChangeSessions",
        "title": "%command.compareChangeSessions%"
      },
      {
        "command": "cursorSubscription.reviewChangeSession",
        "title": "%command.reviewChangeSession%"
      },
      {
        "command": "cursorSubscription.openFailureTimeMachine",
        "title": "%command.openFailureTimeMachine%"
      },
      {
        "command": "cursorSubscription.reverifyChangeSession",
        "title": "%command.reverifyChangeSession%"
      },
      {
        "command": "cursorSubscription.executeLastPlan",
        "title": "%command.executeLastPlan%"
      },
      {
        "command": "cursorSubscription.compareSessionContents",
        "title": "%command.compareSessionContents%"
      },
      {
        "command": "cursorSubscription.startBackgroundJob",
        "title": "%command.startBackgroundJob%",
        "icon": "$(add)"
      },
      {
        "command": "cursorSubscription.refreshBackgroundJobs",
        "title": "%command.refreshBackgroundJobs%",
        "icon": "$(refresh)"
      },
      {
        "command": "cursorSubscription.applyBackgroundJob",
        "title": "%command.applyBackgroundJob%",
        "icon": "$(check)"
      },
      {
        "command": "cursorSubscription.openBackgroundChange",
        "title": "%command.openBackgroundChange%"
      },
      {
        "command": "cursorSubscription.cancelBackgroundJob",
        "title": "%command.cancelBackgroundJob%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "cursorSubscription.discardBackgroundJob",
        "title": "%command.discardBackgroundJob%",
        "icon": "$(discard)"
      },
      {
        "command": "cursorSubscription.cleanupAppliedBackgroundJob",
        "title": "%command.cleanupAppliedBackgroundJob%",
        "icon": "$(clear-all)"
      },
      {
        "command": "cursorSubscription.refreshAuditTimeline",
        "title": "%command.refreshAuditTimeline%",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cursorSubscription.openRunCenter",
          "when": "view == cursorSubscription.workspaceTree",
          "group": "navigation@1"
        },
        {
          "command": "cursorSubscription.chooseWorkflow",
          "when": "view == cursorSubscription.chatView || view == cursorSubscription.workspaceTree",
          "group": "navigation@2"
        },
        {
          "command": "cursorSubscription.chooseExecutionProfile",
          "when": "view == cursorSubscription.chatView || view == cursorSubscription.workspaceTree",
          "group": "navigation@3"
        },
        {
          "command": "cursorSubscription.openOutput",
          "when": "view == cursorSubscription.workspaceTree",
          "group": "navigation@4"
        }
      ],
      "scm/title": [
        {
          "command": "cursorSubscription.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "cursorSubscription.addFileToChat",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "cursor@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "cursorSubscription.addFileToChat",
          "when": "resourceScheme == file",
          "group": "cursor@1"
        }
      ],
      "editor/context": [
        {
          "command": "cursorSubscription.generateCode",
          "when": "editorTextFocus && !editorReadonly",
          "group": "cursor@1"
        },
        {
          "command": "cursorSubscription.explainSelection",
          "when": "editorHasSelection",
          "group": "cursor@2"
        },
        {
          "command": "cursorSubscription.addFileToChat",
          "when": "resourceScheme == file",
          "group": "cursor@3"
        },
        {
          "command": "cursorSubscription.debugContext",
          "when": "resourceScheme == file",
          "group": "cursor@4"
        }
      ],
      "view/item/context": [
        {
          "command": "cursorSubscription.keepSessionEdit",
          "when": "view == cursorSubscription.workspaceTree && (viewItem == cursorAiSession.file.pending || viewItem == cursorAiSession.file.pendingKeepOnly)",
          "group": "inline@1"
        },
        {
          "command": "cursorSubscription.restoreSessionEdit",
          "when": "view == cursorSubscription.workspaceTree && viewItem == cursorAiSession.file.pending",
          "group": "inline@2"
        },
        {
          "command": "cursorSubscription.runSupervisorTask",
          "when": "view == cursorSubscription.workspaceTree && (viewItem == cursorSupervisor.task.detected || viewItem == cursorSupervisor.task.queued || viewItem == cursorSupervisor.task.failed)",
          "group": "inline@1"
        },
        {
          "command": "cursorSubscription.applyAllSupervisorChanges",
          "when": "view == cursorSubscription.workspaceTree && (viewItem == cursorSupervisor.task.review || viewItem == cursorSupervisor.task.blocked)",
          "group": "inline@1"
        },
        {
          "command": "cursorSubscription.discardAllSupervisorChanges",
          "when": "view == cursorSubscription.workspaceTree && (viewItem == cursorSupervisor.task.review || viewItem == cursorSupervisor.task.blocked)",
          "group": "inline@2"
        },
        {
          "command": "cursorSubscription.dismissSupervisorTask",
          "when": "view == cursorSubscription.workspaceTree && (viewItem == cursorSupervisor.task.detected || viewItem == cursorSupervisor.task.queued || viewItem == cursorSupervisor.task.failed || viewItem == cursorSupervisor.task.completed)",
          "group": "inline@3"
        },
        {
          "command": "cursorSubscription.applySupervisorChange",
          "when": "view == cursorSubscription.workspaceTree && viewItem == cursorSupervisor.change.pending",
          "group": "inline@1"
        },
        {
          "command": "cursorSubscription.discardSupervisorChange",
          "when": "view == cursorSubscription.workspaceTree && (viewItem == cursorSupervisor.change.pending || viewItem == cursorSupervisor.change.excluded)",
          "group": "inline@2"
        },
        {
          "command": "cursorSubscription.enableIntegration",
          "when": "view == cursorSubscription.workspaceTree && viewItem == cursorIntegration.item.disabled",
          "group": "inline@1"
        },
        {
          "command": "cursorSubscription.disableIntegration",
          "when": "view == cursorSubscription.workspaceTree && viewItem == cursorIntegration.item.enabled",
          "group": "inline@1"
        },
        {
          "command": "cursorSubscription.openIntegration",
          "when": "view == cursorSubscription.workspaceTree && viewItem =~ /cursorIntegration\\.item\\./",
          "group": "inline@2"
        },
        {
          "command": "cursorSubscription.applyBackgroundJob",
          "when": "view == cursorSubscription.workspaceTree && viewItem == cursorBackground.job.completed",
          "group": "inline@1"
        },
        {
          "command": "cursorSubscription.cancelBackgroundJob",
          "when": "view == cursorSubscription.workspaceTree && (viewItem == cursorBackground.job.starting || viewItem == cursorBackground.job.running)",
          "group": "inline@1"
        },
        {
          "command": "cursorSubscription.discardBackgroundJob",
          "when": "view == cursorSubscription.workspaceTree && (viewItem == cursorBackground.job.completed || viewItem == cursorBackground.job.error || viewItem == cursorBackground.job.cancelled)",
          "group": "inline@2"
        },
        {
          "command": "cursorSubscription.cleanupAppliedBackgroundJob",
          "when": "view == cursorSubscription.workspaceTree && viewItem == cursorBackground.job.applied",
          "group": "inline@2"
        },
        {
          "command": "cursorSubscription.createSupervisorTask",
          "when": "view == cursorSubscription.workspaceTree && viewItem == cursorSidebar.group.inbox",
          "group": "1_inbox@1"
        },
        {
          "command": "cursorSubscription.scanSupervisorDiagnostics",
          "when": "view == cursorSubscription.workspaceTree && viewItem == cursorSidebar.group.inbox",
          "group": "1_inbox@2"
        },
        {
          "command": "cursorSubscription.chooseSupervisorMode",
          "when": "view == cursorSubscription.workspaceTree && viewItem == cursorSidebar.group.inbox",
          "group": "1_inbox@3"
        },
        {
          "command": "cursorSubscription.scanSupervisorTodos",
          "when": "view == cursorSubscription.workspaceTree && viewItem == cursorSidebar.group.inbox",
          "group": "1_inbox@4"
        },
        {
          "command": "cursorSubscription.scanSupervisorGitHub",
          "when": "view == cursorSubscription.workspaceTree && viewItem == cursorSidebar.group.inbox",
          "group": "1_inbox@5"
        },
        {
          "command": "cursorSubscription.refreshIntegrations",
          "when": "view == cursorSubscription.workspaceTree && viewItem == cursorSidebar.group.integrations",
          "group": "1_integrations@1"
        },
        {
          "command": "cursorSubscription.startBackgroundJob",
          "when": "view == cursorSubscription.workspaceTree && viewItem == cursorSidebar.group.background",
          "group": "1_background@1"
        },
        {
          "command": "cursorSubscription.refreshBackgroundJobs",
          "when": "view == cursorSubscription.workspaceTree && viewItem == cursorSidebar.group.background",
          "group": "1_background@2"
        },
        {
          "command": "cursorSubscription.refreshAuditTimeline",
          "when": "view == cursorSubscription.workspaceTree && viewItem == cursorSidebar.group.audit",
          "group": "1_audit@1"
        },
        {
          "command": "cursorSubscription.exportAuditLog",
          "when": "view == cursorSubscription.workspaceTree && viewItem == cursorSidebar.group.audit",
          "group": "1_audit@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursorSubscription",
          "title": "Cursor",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "cursorSubscription": [
        {
          "type": "webview",
          "id": "cursorSubscription.chatView",
          "name": "%view.agent%",
          "initialSize": 12
        },
        {
          "id": "cursorSubscription.workspaceTree",
          "name": "%view.workspaceTree%",
          "initialSize": 4
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cursorSubscription.chatView",
        "contents": "%viewsWelcome.chat%"
      },
      {
        "view": "cursorSubscription.workspaceTree",
        "contents": "%viewsWelcome.workspace%"
      }
    ],
    "configuration": {
      "title": "%extension.displayName%",
      "properties": {
        "cursorSubscription.executionProfile": {
          "type": "string",
          "enum": [
            "safe",
            "balanced",
            "automation"
          ],
          "markdownDescription": "%config.executionProfile.description%",
          "order": 0
        },
        "cursorSubscription.enableAiNativeFeatures": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "description": "%config.enableAiNativeFeatures.description%"
        },
        "cursorSubscription.maxParallelChatAgents": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "order": 2,
          "description": "%config.maxParallelChatAgents.description%"
        },
        "cursorSubscription.runPreparationTimeoutSeconds": {
          "type": "integer",
          "default": 120,
          "minimum": 15,
          "maximum": 600,
          "order": 2,
          "description": "%config.runPreparationTimeoutSeconds.description%"
        },
        "cursorSubscription.bestOfNCount": {
          "type": "integer",
          "default": 3,
          "minimum": 2,
          "maximum": 5,
          "order": 2,
          "description": "%config.bestOfNCount.description%"
        },
        "cursorSubscription.bestOfNAutoSelect": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "description": "%config.bestOfNAutoSelect.description%"
        },
        "cursorSubscription.bestOfNAutoJudge": {
          "type": "boolean",
          "default": false,
          "order": 2,
          "description": "%config.bestOfNAutoJudge.description%"
        },
        "cursorSubscription.orchestrateHandoffConversation": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "description": "%config.orchestrateHandoffConversation.description%"
        },
        "cursorSubscription.offerPullRequestAfterVerify": {
          "type": "boolean",
          "default": true,
          "description": "%config.offerPullRequestAfterVerify.description%"
        },
        "cursorSubscription.defaultBaseBranch": {
          "type": "string",
          "default": "main",
          "description": "%config.defaultBaseBranch.description%"
        },
        "cursorSubscription.preEditCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.preEditCommands.description%"
        },
        "cursorSubscription.postEditCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.postEditCommands.description%"
        },
        "cursorSubscription.enableAiSupervisor": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "description": "%config.enableAiSupervisor.description%"
        },
        "cursorSubscription.supervisorMode": {
          "type": "string",
          "enum": [
            "off",
            "observe",
            "autonomous"
          ],
          "enumDescriptions": [
            "%config.supervisorMode.off%",
            "%config.supervisorMode.observe%",
            "%config.supervisorMode.autonomous%"
          ],
          "default": "observe",
          "order": 3,
          "description": "%config.supervisorMode.description%"
        },
        "cursorSubscription.supervisorDebounceSeconds": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 300,
          "description": "%config.supervisorDebounceSeconds.description%"
        },
        "cursorSubscription.supervisorMaxFiles": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 100,
          "description": "%config.supervisorMaxFiles.description%"
        },
        "cursorSubscription.supervisorMaxChangedLines": {
          "type": "integer",
          "default": 300,
          "minimum": 10,
          "maximum": 10000,
          "description": "%config.supervisorMaxChangedLines.description%"
        },
        "cursorSubscription.supervisorMaxAiRunsPerHour": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 100,
          "description": "%config.supervisorMaxAiRunsPerHour.description%"
        },
        "cursorSubscription.supervisorMaxRunMinutes": {
          "type": "integer",
          "default": 15,
          "minimum": 1,
          "maximum": 240,
          "description": "%config.supervisorMaxRunMinutes.description%"
        },
        "cursorSubscription.supervisorExcludedGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.env*",
            "**/.netrc",
            "**/_netrc",
            "**/.npmrc",
            "**/.pypirc",
            "**/.yarnrc",
            "**/.yarnrc.yml",
            "**/.gem/credentials",
            "**/.docker/config.json",
            "**/.config/gh/hosts.yml",
            "**/.kube/config",
            "**/*secret*",
            "**/*credential*",
            "**/*.pem",
            "**/*.key",
            "**/package-lock.json",
            "**/pnpm-lock.yaml",
            "**/yarn.lock"
          ],
          "description": "%config.supervisorExcludedGlobs.description%"
        },
