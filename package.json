{
  "name": "cursor-subscription-for-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.12",
  "publisher": "ark4ez",
  "license": "MIT",
  "type": "module",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ark4ez/cursor-agent-vscode-extension.git"
  },
  "bugs": {
    "url": "https://github.com/ark4ez/cursor-agent-vscode-extension/issues"
  },
  "homepage": "https://github.com/ark4ez/cursor-agent-vscode-extension#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "cursor",
    "agent",
    "ai",
    "chat",
    "sdk"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onView:cursorSubscription.chatView",
    "onView:cursorSubscription.changeSessions",
    "onView:cursorSubscription.supervisorTasks",
    "onCommand:cursorSubscription.generateCommitMessage",
    "onCommand:cursorSubscription.generateCode",
    "onCommand:cursorSubscription.explainSelection",
    "onCommand:cursorSubscription.addFileToChat",
    "onCommand:cursorSubscription.runAutopilot",
    "onCommand:cursorSubscription.reviewChanges",
    "onCommand:cursorSubscription.debugContext"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "validate:webview": "node scripts/validate-webview.mjs",
    "validate": "npm run compile && npm run validate:webview",
    "vscode:prepublish": "npm run validate",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "contributes": {
    "commands": [
      {
        "command": "cursorSubscription.openChat",
        "title": "%command.openChat%"
      },
      {
        "command": "cursorSubscription.openSettings",
        "title": "%command.openSettings%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "cursorSubscription.setApiKey",
        "title": "%command.setApiKey%"
      },
      {
        "command": "cursorSubscription.clearApiKey",
        "title": "%command.clearApiKey%"
      },
      {
        "command": "cursorSubscription.newChat",
        "title": "%command.newChat%"
      },
      {
        "command": "cursorSubscription.generateCommitMessage",
        "title": "%command.generateCommitMessage%",
        "icon": "$(sparkle)"
      },
      {
        "command": "cursorSubscription.generateCode",
        "title": "%command.generateCode%"
      },
      {
        "command": "cursorSubscription.explainSelection",
        "title": "%command.explainSelection%"
      },
      {
        "command": "cursorSubscription.addFileToChat",
        "title": "%command.addFileToChat%"
      },
      {
        "command": "cursorSubscription.runAutopilot",
        "title": "%command.runAutopilot%"
      },
      {
        "command": "cursorSubscription.reviewChanges",
        "title": "%command.reviewChanges%"
      },
      {
        "command": "cursorSubscription.clearReview",
        "title": "%command.clearReview%"
      },
      {
        "command": "cursorSubscription.debugContext",
        "title": "%command.debugContext%"
      },
      {
        "command": "cursorSubscription.refreshProjectMemory",
        "title": "%command.refreshProjectMemory%"
      },
      {
        "command": "cursorSubscription.verifyChanges",
        "title": "%command.verifyChanges%"
      },
      {
        "command": "cursorSubscription.revertLastSession",
        "title": "%command.revertLastSession%"
      },
      {
        "command": "cursorSubscription.keepSessionEdit",
        "title": "%command.keepSessionEdit%",
        "icon": "$(check)"
      },
      {
        "command": "cursorSubscription.restoreSessionEdit",
        "title": "%command.restoreSessionEdit%",
        "icon": "$(discard)"
      },
      {
        "command": "cursorSubscription.keepAllSessionEdits",
        "title": "%command.keepAllSessionEdits%"
      },
      {
        "command": "cursorSubscription.restoreAllSessionEdits",
        "title": "%command.restoreAllSessionEdits%"
      },
      {
        "command": "cursorSubscription.chooseSupervisorMode",
        "title": "%command.chooseSupervisorMode%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "cursorSubscription.createSupervisorTask",
        "title": "%command.createSupervisorTask%",
        "icon": "$(add)"
      },
      {
        "command": "cursorSubscription.scanSupervisorDiagnostics",
        "title": "%command.scanSupervisorDiagnostics%",
        "icon": "$(search)"
      },
      {
        "command": "cursorSubscription.runSupervisorTask",
        "title": "%command.runSupervisorTask%",
        "icon": "$(play)"
      },
      {
        "command": "cursorSubscription.openSupervisorChange",
        "title": "%command.openSupervisorChange%"
      },
      {
        "command": "cursorSubscription.applySupervisorChange",
        "title": "%command.applySupervisorChange%",
        "icon": "$(check)"
      },
      {
        "command": "cursorSubscription.discardSupervisorChange",
        "title": "%command.discardSupervisorChange%",
        "icon": "$(discard)"
      },
      {
        "command": "cursorSubscription.applyAllSupervisorChanges",
        "title": "%command.applyAllSupervisorChanges%",
        "icon": "$(check-all)"
      },
      {
        "command": "cursorSubscription.discardAllSupervisorChanges",
        "title": "%command.discardAllSupervisorChanges%"
      },
      {
        "command": "cursorSubscription.dismissSupervisorTask",
        "title": "%command.dismissSupervisorTask%",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "cursorSubscription.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "cursorSubscription.addFileToChat",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "cursor@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "cursorSubscription.addFileToChat",
          "when": "resourceScheme == file",
          "group": "cursor@1"
        }
      ],
      "editor/context": [
        {
          "command": "cursorSubscription.generateCode",
          "when": "editorTextFocus && !editorReadonly",
          "group": "cursor@1"
        },
        {
          "command": "cursorSubscription.explainSelection",
          "when": "editorHasSelection",
          "group": "cursor@2"
        },
        {
          "command": "cursorSubscription.addFileToChat",
          "when": "resourceScheme == file",
          "group": "cursor@3"
        },
        {
          "command": "cursorSubscription.debugContext",
          "when": "resourceScheme == file",
          "group": "cursor@4"
        }
      ],
      "view/item/context": [
        {
          "command": "cursorSubscription.keepSessionEdit",
          "when": "view == cursorSubscription.changeSessions && (viewItem == cursorAiSession.file.pending || viewItem == cursorAiSession.file.pendingKeepOnly)",
          "group": "inline@1"
        },
        {
          "command": "cursorSubscription.restoreSessionEdit",
          "when": "view == cursorSubscription.changeSessions && viewItem == cursorAiSession.file.pending",
          "group": "inline@2"
        },
        {
          "command": "cursorSubscription.runSupervisorTask",
          "when": "view == cursorSubscription.supervisorTasks && (viewItem == cursorSupervisor.task.detected || viewItem == cursorSupervisor.task.queued || viewItem == cursorSupervisor.task.failed)",
          "group": "inline@1"
        },
        {
          "command": "cursorSubscription.applyAllSupervisorChanges",
          "when": "view == cursorSubscription.supervisorTasks && (viewItem == cursorSupervisor.task.review || viewItem == cursorSupervisor.task.blocked)",
          "group": "inline@1"
        },
        {
          "command": "cursorSubscription.discardAllSupervisorChanges",
          "when": "view == cursorSubscription.supervisorTasks && (viewItem == cursorSupervisor.task.review || viewItem == cursorSupervisor.task.blocked)",
          "group": "inline@2"
        },
        {
          "command": "cursorSubscription.dismissSupervisorTask",
          "when": "view == cursorSubscription.supervisorTasks && (viewItem == cursorSupervisor.task.detected || viewItem == cursorSupervisor.task.queued || viewItem == cursorSupervisor.task.failed || viewItem == cursorSupervisor.task.completed)",
          "group": "inline@3"
        },
        {
          "command": "cursorSubscription.applySupervisorChange",
          "when": "view == cursorSubscription.supervisorTasks && viewItem == cursorSupervisor.change.pending",
          "group": "inline@1"
        },
        {
          "command": "cursorSubscription.discardSupervisorChange",
          "when": "view == cursorSubscription.supervisorTasks && (viewItem == cursorSupervisor.change.pending || viewItem == cursorSupervisor.change.excluded)",
          "group": "inline@2"
        }
      ],
      "view/title": [
        {
          "command": "cursorSubscription.createSupervisorTask",
          "when": "view == cursorSubscription.supervisorTasks",
          "group": "navigation@1"
        },
        {
          "command": "cursorSubscription.scanSupervisorDiagnostics",
          "when": "view == cursorSubscription.supervisorTasks",
          "group": "navigation@2"
        },
        {
          "command": "cursorSubscription.chooseSupervisorMode",
          "when": "view == cursorSubscription.supervisorTasks",
          "group": "navigation@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursorSubscription",
          "title": "Cursor",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "cursorSubscription": [
        {
          "type": "webview",
          "id": "cursorSubscription.chatView",
          "name": "%view.agent%"
        },
        {
          "id": "cursorSubscription.changeSessions",
          "name": "%view.changeSessions%"
        },
        {
          "id": "cursorSubscription.supervisorTasks",
          "name": "%view.supervisorTasks%"
        }
      ]
    },
    "configuration": {
      "title": "%extension.displayName%",
      "properties": {
        "cursorSubscription.enableAiNativeFeatures": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "description": "%config.enableAiNativeFeatures.description%"
        },
        "cursorSubscription.maxParallelChatAgents": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "order": 2,
          "description": "%config.maxParallelChatAgents.description%"
        },
        "cursorSubscription.enableAiSupervisor": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "description": "%config.enableAiSupervisor.description%"
        },
        "cursorSubscription.supervisorMode": {
          "type": "string",
          "enum": [
            "off",
            "observe",
            "autonomous"
          ],
          "enumDescriptions": [
            "%config.supervisorMode.off%",
            "%config.supervisorMode.observe%",
            "%config.supervisorMode.autonomous%"
          ],
          "default": "observe",
          "order": 3,
          "description": "%config.supervisorMode.description%"
        },
        "cursorSubscription.supervisorDebounceSeconds": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 300,
          "description": "%config.supervisorDebounceSeconds.description%"
        },
        "cursorSubscription.supervisorMaxFiles": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 100,
          "description": "%config.supervisorMaxFiles.description%"
        },
        "cursorSubscription.supervisorMaxChangedLines": {
          "type": "integer",
          "default": 300,
          "minimum": 10,
          "maximum": 10000,
          "description": "%config.supervisorMaxChangedLines.description%"
        },
        "cursorSubscription.supervisorMaxAiRunsPerHour": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 100,
          "description": "%config.supervisorMaxAiRunsPerHour.description%"
        },
        "cursorSubscription.supervisorMaxRunMinutes": {
          "type": "integer",
          "default": 15,
          "minimum": 1,
          "maximum": 240,
          "description": "%config.supervisorMaxRunMinutes.description%"
        },
        "cursorSubscription.supervisorExcludedGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.env*",
            "**/*secret*",
            "**/*credential*",
            "**/*.pem",
            "**/*.key",
            "**/package-lock.json",
            "**/pnpm-lock.yaml",
            "**/yarn.lock"
          ],
          "description": "%config.supervisorExcludedGlobs.description%"
        },
        "cursorSubscription.supervisorAutoApplySafeChanges": {
          "type": "boolean",
          "default": false,
          "description": "%config.supervisorAutoApplySafeChanges.description%"
        },
        "cursorSubscription.enableAutopilot": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "description": "%config.enableAutopilot.description%"
        },
        "cursorSubscription.enableChangeSessions": {
          "type": "boolean",
          "default": true,
          "order": 3,
          "description": "%config.enableChangeSessions.description%"
        },
        "cursorSubscription.previewGeneratedCode": {
          "type": "boolean",
          "default": true,
          "order": 4,
          "description": "%config.previewGeneratedCode.description%"
        },
        "cursorSubscription.enableDiagnosticQuickFixes": {
          "type": "boolean",
          "default": true,
          "order": 5,
          "description": "%config.enableDiagnosticQuickFixes.description%"
        },
        "cursorSubscription.enableAiReview": {
          "type": "boolean",
          "default": true,
          "order": 6,
          "description": "%config.enableAiReview.description%"
        },
        "cursorSubscription.enableVerification": {
          "type": "boolean",
          "default": true,
          "order": 7,
          "description": "%config.enableVerification.description%"
        },
        "cursorSubscription.enableDebugContext": {
          "type": "boolean",
          "default": true,
          "order": 8,
          "description": "%config.enableDebugContext.description%"
        },
        "cursorSubscription.enableProjectMemory": {
          "type": "boolean",
          "default": true,
          "order": 9,
          "description": "%config.enableProjectMemory.description%"
        },
        "cursorSubscription.notifyOnComplete": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifyOnComplete.description%"
        },
        "cursorSubscription.playSoundWhileRunning": {
          "type": "boolean",
          "default": true,
          "description": "%config.playSoundWhileRunning.description%"
        },
        "cursorSubscription.playSoundOnComplete": {
          "type": "boolean",
          "default": true,
          "description": "%config.playSoundOnComplete.description%"
        },
        "cursorSubscription.playSoundOnError": {
          "type": "boolean",
          "default": true,
          "description": "%config.playSoundOnError.description%"
        },
        "cursorSubscription.autoVerify": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoVerify.description%"
        },
        "cursorSubscription.autoRepair": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoRepair.description%"
        },
        "cursorSubscription.maxAutoRepairAttempts": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "maximum": 3,
          "description": "%config.maxAutoRepairAttempts.description%"
        },
        "cursorSubscription.verificationCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.verificationCommands.description%"
        },
        "cursorSubscription.enableInlineCompletions": {
          "type": "boolean",
          "default": false,
          "description": "%config.enableInlineCompletions.description%"
        },
        "cursorSubscription.includeProjectMemory": {
          "type": "boolean",
          "default": true,
          "description": "%config.includeProjectMemory.description%"
        }
      }
    }
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.23",
    "dompurify": "^3.4.12",
    "marked": "^18.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  }
}
